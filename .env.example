# KulimaAPI Environment Configuration
# Copy this file to .env and fill in the values

# Server
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Database (PostgreSQL)
DATABASE_URL=postgresql://kulima:kulima_secret@localhost:5432/kulima_db

# Redis
REDIS_URL=redis://localhost:6379

# API Authentication
API_KEY_SALT_ROUNDS=12
JWT_SECRET=your-jwt-secret-change-in-production

# External Providers
OPEN_METEO_BASE_URL=https://api.open-meteo.com
OPEN_METEO_API_KEY=

# Rate Limiting
RATE_LIMIT_FREE=1000
RATE_LIMIT_DEVELOPER=10000
RATE_LIMIT_BUSINESS=100000

# Cache TTLs (in seconds)
CACHE_TTL_CURRENT_WEATHER=900
CACHE_TTL_FORECAST=3600
CACHE_TTL_HISTORICAL=86400
CACHE_TTL_LOCATION=2592000

# CORS
CORS_ORIGIN=http://localhost:3001

# Dashboard
DASHBOARD_URL=http://localhost:3001

# Deployment
GOOGLE_CLOUD_PROJECT=
RENDER_SERVICE_ID=
RAILWAY_TOKEN=
