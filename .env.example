# KulimaAPI Environment Configuration
# Copy this file to .env and fill in the values

# Server
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Database (PostgreSQL)
DATABASE_URL=postgresql://kulima:kulima_secret@localhost:5432/kulima_db

# Redis
REDIS_URL=redis://localhost:6379

# API Authentication
API_KEY_SALT_ROUNDS=12
JWT_SECRET=your-jwt-secret-change-in-production

# External Providers
OPEN_METEO_BASE_URL=https://api.open-meteo.com
OPEN_METEO_API_KEY=

# AI Advisor (Anthropic — optional)
# Without an API key, POST /v2/advisor/explain returns a plain English template fallback.
# Keep this server-side only; never commit real keys.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Rate Limiting
RATE_LIMIT_FREE=1000
RATE_LIMIT_DEVELOPER=10000
RATE_LIMIT_BUSINESS=100000

# Cache TTLs (in seconds)
CACHE_TTL_CURRENT_WEATHER=900
CACHE_TTL_FORECAST=3600
CACHE_TTL_HISTORICAL=86400
CACHE_TTL_LOCATION=2592000

# CORS
CORS_ORIGIN=http://localhost:3001

# Dashboard
DASHBOARD_URL=http://localhost:3001

# Deployment
GOOGLE_CLOUD_PROJECT=
RENDER_SERVICE_ID=
RAILWAY_TOKEN=

# Max unauthenticated sign-ups (POST /v1/auth/keys without a key) per IP per hour
SIGNUP_RATE_LIMIT_PER_HOUR=10

# In-memory fallback when PostgreSQL is down (development only; always off when NODE_ENV=production)
# ALLOW_MEMORY_FALLBACK=false

# Number of API servers behind the load balancer. When Redis is down, each server
# enforces 1/INSTANCE_COUNT of a key's rate limit so the total stays correct.
INSTANCE_COUNT=1

# Max entries in the per-server in-memory cache (oldest are evicted first)
MEMORY_CACHE_MAX_ENTRIES=5000
